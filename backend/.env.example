# Copy to backend/.env (git-ignored). Missing secrets are generated per run and printed at startup.
HCS_INGEST_TOKEN=
HCS_DASHBOARD_USER=support
HCS_DASHBOARD_PASSWORD=
# HCS_BACKEND_HOST=127.0.0.1
# HCS_BACKEND_PORT=8766
# HCS_BACKEND_DB=runs/backend.sqlite3
# HCS_GROUP_THRESHOLD=0.3
# Stripe Checkout for the landing paywall — TEST keys only (sk_test_...)
STRIPE_SECRET_KEY=
# HCS_LANDING_URL=http://127.0.0.1:5173

# Auto-fix with Devin (Cognition) — only repos on the allowlist are ever targeted
# "Software name=owner/repo; ..." (software name as in the reports)
HCS_FIX_REPOS=Fake CRM=Tooom123/hcs-sandbox-fake-crm
# 1 = start Devin automatically on suspected_product_defect cases (else: dashboard button only)
HCS_FIX_AUTO=1
# auto (Devin if DEVIN_API_KEY is set, else simulated) | devin | mock
HCS_FIX_PROVIDER=auto
DEVIN_API_KEY=
DEVIN_ORG_ID=
# ACU cap per Devin session
HCS_FIX_MAX_ACU=5

# ElevenLabs key: the agent's spoken notes read it from here too (see the root .env.example, HCS_TTS_*)
ELEVEN=
