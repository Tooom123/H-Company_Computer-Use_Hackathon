# Copy to .env at the repo root or in agent/ (both git-ignored) and fill in. `hcs-agent` loads the nearest one.

# --- H Company (required) -------------------------------------------------------------------
# Get it on https://platform.hcompany.ai (API keys), or run `uv run holo login` instead.
HAI_API_KEY=

# --- Gladia (voice input) --------------------------------------------------------------------
# Push-to-talk: hold the hotkey, say what you want, release; Gladia transcribes and the run starts.
# Key: https://app.gladia.io
GLADIA_API_KEY=
# Language spoken to the assistant (fr, en, de, es, it). solaria-3 model needs exactly one.
HCS_VOICE_LANGUAGE=fr
# Push-to-talk key: a key (f9, alt_r) or a combo (cmd+h, ctrl+alt+space). Avoid F8 (Apple Music).
HCS_PTT_KEY=cmd+h

# --- ElevenLabs (optional, spoken notes) -----------------------------------------------------
# The assistant reads aloud each note it writes on screen (guide steps, takeover narration, closing note);
# the pencil drawing starts with the voice. Empty = silent. Also read from backend/.env (ELEVEN=...).
# Key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# 0 = mute. Voice id (default Sarah; Jessica = cgSgspJ2msm6clMCkdW9), model, speed (0.7-1.2).
HCS_TTS=1
HCS_TTS_VOICE=EXAVITQu4vr4xnSDxMaL
HCS_TTS_MODEL=eleven_flash_v2_5
HCS_TTS_SPEED=1.0

# --- Linkup (optional) -----------------------------------------------------------------------
# Lets the agent search the web when it needs info (tool `lookup_docs`), and documents blockers.
# Leave empty to disable. Key: https://app.linkup.so
LINKUP_API_KEY=

# --- Agent behaviour (optional, defaults shown) ----------------------------------------------
# Holo model used for the desktop agent. holo4-35b-a3b = lower latency; holo4-27b = default quality.
HCS_MODEL=holo4-35b-a3b
# Max screenshot width sent to H (smaller = faster).
HCS_SCREENSHOT_MAX_WIDTH=1280
# Where reports and evidence screenshots are written.
HCS_RUNS_DIR=runs
# 1 = add a sourced web summary to the plan before approval (needs LINKUP_API_KEY).
HCS_GROUND_PLAN=0
# 1 = restrict web searches to the software vendor's domains.
HCS_RESTRICT_DOMAINS=0

# --- Development without H / desktop permissions ---------------------------------------------
# 1 = simulated backend; every event and report is flagged simulated=true.
HCS_MOCK=0
# Mock scenario: done | blocked | fail_verify
# HCS_MOCK_OUTCOME=done
