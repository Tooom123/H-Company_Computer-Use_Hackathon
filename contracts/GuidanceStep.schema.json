{
  "$defs": {
    "Annotation": {
      "description": "An extra mark drawn on screen with a step: a box around a zone, a circled element, a label.",
      "properties": {
        "shape": {
          "default": "label",
          "enum": [
            "circle",
            "box",
            "underline",
            "label"
          ],
          "title": "Shape",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "pointer": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointer"
        },
        "size": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "box": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Element bounds (x, y, w, h) in screen points.",
          "title": "Box"
        }
      },
      "title": "Annotation",
      "type": "object"
    }
  },
  "description": "One step explained to the user in guide mode.",
  "properties": {
    "index": {
      "title": "Index",
      "type": "integer"
    },
    "instruction": {
      "description": "What the user should do now, in plain words.",
      "title": "Instruction",
      "type": "string"
    },
    "where": {
      "default": "",
      "description": "Where the control is on screen.",
      "title": "Where",
      "type": "string"
    },
    "why": {
      "default": "",
      "description": "What this step achieves.",
      "title": "Why",
      "type": "string"
    },
    "pointer": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Screen coordinates the agent pointed at.",
      "title": "Pointer"
    },
    "box": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Element bounds (x, y, w, h) in screen points.",
      "title": "Box"
    },
    "box_exact": {
      "default": false,
      "description": "True when the box comes from the accessibility tree (pixel-exact), False when estimated from a screenshot.",
      "title": "Box Exact",
      "type": "boolean"
    },
    "kind": {
      "default": "click",
      "description": "click / type / key: act; info: read, moves on by itself; wait: the agent polls the screen.",
      "enum": [
        "click",
        "type",
        "key",
        "info",
        "wait"
      ],
      "title": "Kind",
      "type": "string"
    },
    "done_when": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Expected visible result to check after an interaction; not an observed or verified outcome.",
      "title": "Done When"
    },
    "prepared_speech": {
      "description": "At most two tentative next instructions for audio preparation only. Never display or advance to these without a fresh observation and guidance response.",
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "title": "Prepared Speech",
      "type": "array"
    },
    "annotations": {
      "items": {
        "$ref": "#/$defs/Annotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "keep_clear": {
      "description": "Screen boxes (x, y, w, h) the overlay notes must not cover, e.g. the dialog that holds the target: its fields and hints stay readable.",
      "items": {
        "maxItems": 4,
        "minItems": 4,
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "integer"
          },
          {
            "type": "integer"
          },
          {
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "title": "Keep Clear",
      "type": "array"
    },
    "last": {
      "default": false,
      "title": "Last",
      "type": "boolean"
    },
    "shown_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shown At"
    },
    "done_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Seconds the user took to do the step.",
      "title": "Done S"
    }
  },
  "required": [
    "index",
    "instruction"
  ],
  "title": "GuidanceStep",
  "type": "object"
}
